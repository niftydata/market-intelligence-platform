# Local Docker Compose database.
DATABASE_URL=postgresql+psycopg://market_intelligence:market_intelligence@localhost:5432/market_intelligence

MARKET_SYMBOL=^AXJO
MARKET_INSTRUMENT_CODE=ASX200
MARKET_HISTORY_YEARS=5
MARKET_INCREMENTAL_OVERLAP_DAYS=7
MARKET_TIMEZONE=Australia/Sydney

RBA_F1_URL=https://www.rba.gov.au/statistics/tables/csv/f1-data.csv
RBA_SERIES_CODE=FIRMMCRID
RBA_HISTORY_YEARS=5
RBA_INCREMENTAL_OVERLAP_DAYS=7

LOG_LEVEL=INFO




ENABLE_AI_ASSISTANT=true
AI_DEMO_USERNAME=macquarie
AI_DEMO_PASSWORD_HASH=<generate-a-pbkdf2-password-hash>
AI_MAX_LOGIN_ATTEMPTS=5
AI_MAX_QUESTIONS_PER_SESSION=20

FOUNDRY_AGENT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>/agents/<agent>/endpoint/protocols/openai/responses
FOUNDRY_AGENT_NAME=<agent-name>
FOUNDRY_AGENT_VERSION=<agent-version>
FOUNDRY_AGENT_API_VERSION=v1
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<service-principal-client-id>
AZURE_CLIENT_SECRET=<set-as-a-secret>
